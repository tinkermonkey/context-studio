# ============================================================================
# Stage 1: Base Environment Setup
# ============================================================================
# Last dependency refresh: 2026-05-13
FROM switchyard-orchestrator:latest

# The base image already includes:
# - Claude CLI (REQUIRED - must be present)
# - Git CLI (REQUIRED - must be present)
# - GitHub CLI (REQUIRED - must be present)
# - Python 3.11
# - Essential build tools
# - procps package (provides 'ps' command needed by Claude CLI)

USER root

# ============================================================================
# Stage 2: Install Project-Specific Runtimes and System Dependencies
# ============================================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install Node.js 22.x (for frontend/ux and Tauri app)
RUN apt-get update && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install system dependencies for SQLite extensions, Python packages, and Tauri
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libssl-dev \
    libsqlite3-dev \
    ca-certificates \
    wget \
    gettext-base \
    libwebkit2gtk-4.1-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    patchelf \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ============================================================================
# Stage 3: Create runtime user BEFORE installing dependencies
# ============================================================================
# Create orchestrator user early so npm ci can run as this user,
# avoiding an expensive chown of 700MB+ node_modules afterward.
RUN groupadd -g 1000 orchestrator || true && \
    useradd -m -u 1000 -g 1000 orchestrator || true && \
    mkdir -p /home/orchestrator/.ssh && \
    chown orchestrator:orchestrator /home/orchestrator/.ssh && \
    chmod 700 /home/orchestrator/.ssh

# ============================================================================
# Stage 4: Pre-install Dependencies
# ============================================================================
WORKDIR /workspace/context-studio

# --- Python Dependencies (local-server/) ---
# pip installs system-wide as root
COPY local-server/requirements.txt ./local-server/requirements.txt
COPY local-server/requirements-dev.txt ./local-server/requirements-dev.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir -r local-server/requirements.txt && \
    pip install --no-cache-dir -r local-server/requirements-dev.txt

# Download spaCy language model for NLP adapter
RUN python -m spacy download en_core_web_sm

# Write pytest.ini so asyncio_mode=auto is always available even if pyproject.toml
# is not readable (e.g., partial bind mounts in orchestrator environments)
RUN printf '[pytest]\nasyncio_mode = auto\n' > local-server/pytest.ini

# Install only version-safe tools globally; typescript and eslint come from
# the project's own node_modules to avoid major-version conflicts (TS 6 vs 5).
RUN npm install -g prettier

# --- Frontend Dependencies (Node.js) ---
# Set up workspace ownership so npm ci runs as orchestrator (avoids 60s+ chown)
RUN mkdir -p /workspace/context-studio/ux /workspace/context-studio/app && \
    chown -R orchestrator:orchestrator /workspace/context-studio

# Copy package manifests with correct ownership
COPY --chown=orchestrator:orchestrator ux/package.json ux/package-lock.json* ./ux/
COPY --chown=orchestrator:orchestrator app/package.json app/package-lock.json* ./app/

# Switch to orchestrator for npm ci — installs node_modules owned by orchestrator directly
USER orchestrator

RUN --mount=type=cache,target=/home/orchestrator/.npm,uid=1000,gid=1000 \
    cd ux && \
    npm ci --legacy-peer-deps

RUN --mount=type=cache,target=/home/orchestrator/.npm,uid=1000,gid=1000 \
    cd app && \
    npm ci

# --- Playwright Chromium for E2E tests ---
# System deps must be installed as root; browser binary installs as orchestrator
USER root
RUN cd /workspace/context-studio/ux && npx --yes playwright install-deps chromium

USER orchestrator
RUN cd /workspace/context-studio/ux && npx --yes playwright install chromium

# ============================================================================
# Stage 5: Runtime Configuration
# ============================================================================
ENV NODE_ENV=development

# ============================================================================
# Stage 6: Verification (MANDATORY)
# ============================================================================
# Verify all critical CLIs are present (from base image)
RUN claude --version && \
    git --version && \
    gh --version

# Verify project-specific tools
RUN node --version && \
    npm --version && \
    python3 --version && \
    pip --version

# Verify Python dependencies are importable
RUN python3 -c "import fastapi; import sqlalchemy; import alembic; import pydantic; import pytest; import pytest_asyncio; import networkx; import rdflib; import boto3; import duckdb; import pyarrow; import datasets; print('Python deps OK')"

# Verify Playwright types and browser are installed
RUN cd /workspace/context-studio/ux && \
    node -e "require('@playwright/test'); console.log('Playwright types OK')" && \
    test -d /home/orchestrator/.cache/ms-playwright/chromium-* && \
    echo "Playwright Chromium browser OK"

# Verify mypy type stubs are installed
RUN python3 -c "import importlib.metadata; importlib.metadata.version('types-networkx'); print('types-networkx OK')" && \
    python3 -c "import importlib.metadata; importlib.metadata.version('types-SQLAlchemy'); print('types-SQLAlchemy OK')" && \
    python3 -c "import importlib.metadata; importlib.metadata.version('pyarrow-stubs'); print('pyarrow-stubs OK')" && \
    python3 -c "import importlib.metadata; importlib.metadata.version('boto3-stubs'); print('boto3-stubs OK')"

# ============================================================================
# Default command
# ============================================================================
CMD ["/bin/bash"]
