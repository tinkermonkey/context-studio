# ============================================================================
# Stage 1: Base Environment Setup
# ============================================================================
# Last dependency refresh: 2026-03-27
FROM switchyard-orchestrator:latest

# The base image already includes:
# - Claude CLI (REQUIRED - must be present)
# - Git CLI (REQUIRED - must be present)
# - GitHub CLI (REQUIRED - must be present)
# - Python 3.11
# - Essential build tools
# - procps package (provides 'ps' command needed by Claude CLI)

USER root

# ============================================================================
# Stage 2: Install Project-Specific Runtimes and System Dependencies
# ============================================================================
# Install Node.js 22.x and build dependencies for SQLite extensions and Tauri

# Set environment to avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install Node.js 22.x (for frontend/ux and Tauri app)
RUN apt-get update && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install system dependencies for SQLite extensions, Python packages, and Tauri
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libssl-dev \
    libsqlite3-dev \
    ca-certificates \
    wget \
    gettext-base \
    libwebkit2gtk-4.1-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    patchelf \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ============================================================================
# Stage 3: Pre-install Dependencies (RECOMMENDED for fast startup)
# ============================================================================
# WORKDIR should match where the orchestrator will mount the project
WORKDIR /workspace/context-studio

# ============================================================================
# Python Dependencies - local-server/
# ============================================================================
# Copy only dependency manifests for installation
COPY local-server/requirements.txt ./local-server/requirements.txt
COPY local-server/requirements-dev.txt ./local-server/requirements-dev.txt

# Install Python dependencies (system-wide, no venv needed in container)
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir -r local-server/requirements.txt && \
    pip install --no-cache-dir -r local-server/requirements-dev.txt

# ============================================================================
# Frontend Dependencies (Node.js) - ux/
# ============================================================================
# Copy only package manifests for installation
COPY ux/package.json ux/package-lock.json* ./ux/

# Install UX dependencies with cache mount for faster builds
RUN --mount=type=cache,target=/root/.npm \
    cd ux && \
    npm ci --legacy-peer-deps

# ============================================================================
# Desktop App Dependencies (Node.js) - app/
# ============================================================================
# Copy only package manifests for installation
COPY app/package.json app/package-lock.json* ./app/

# Install app dependencies with cache mount for faster builds
RUN --mount=type=cache,target=/root/.npm \
    cd app && \
    npm ci

# Install Node.js development tools globally
RUN npm install -g prettier eslint typescript

# ============================================================================
# Stage 4: Ownership and Permissions
# ============================================================================
# Change ownership ONLY of what was installed, NOT source code
# Source code ownership is handled by the mount

# Create orchestrator user (matches orchestrator container for consistent permissions)
# Use GID 1000 as primary group to avoid conflicts
RUN groupadd -g 1000 orchestrator || true && \
    useradd -m -u 1000 -g 1000 orchestrator || true && \
    mkdir -p /home/orchestrator/.ssh && \
    chown orchestrator:orchestrator /home/orchestrator/.ssh && \
    chmod 700 /home/orchestrator/.ssh

# Change ownership of installed dependencies
RUN chown -R orchestrator:orchestrator /workspace/context-studio/ux/node_modules && \
    chown -R orchestrator:orchestrator /workspace/context-studio/app/node_modules

# ============================================================================
# Stage 5: Switch to Runtime User
# ============================================================================
USER orchestrator

# Set environment variables for all tech stacks
ENV NODE_ENV=development

# ============================================================================
# Stage 6: Verification (MANDATORY)
# ============================================================================
# Verify all critical CLIs are present (from base image)
RUN claude --version && \
    git --version && \
    gh --version

# Verify project-specific tools
RUN node --version && \
    npm --version && \
    python3 --version && \
    pip --version

# Verify Python dependencies are importable
RUN python3 -c "import fastapi; import sqlalchemy; import alembic; import pydantic; import pytest; import networkx; import rdflib; print('Python deps OK')"

# Verify mypy type stubs are installed
RUN python3 -c "import importlib.metadata; importlib.metadata.version('types-networkx'); print('types-networkx OK')" && \
    python3 -c "import importlib.metadata; importlib.metadata.version('types-SQLAlchemy'); print('types-SQLAlchemy OK')"

# ============================================================================
# Default command
# ============================================================================
CMD ["/bin/bash"]
