# Metrics artifacts (only ignores root-level _metrics/, not test fixtures)
/_metrics/

# Closed-loop optimizer telemetry (generated; run-specific timestamps/run-ids)
tests/integration/fixtures/pipelines/_metrics/quality_loop_*.jsonl

# Loop B variant-tournament telemetry (generated; run-specific timestamps/run-ids)
tests/integration/fixtures/pipelines/_metrics/quality_tournament_*.jsonl

# Karpathy loop error reports (generated per evaluation run; see experiments/README.md)
experiments/reports/*.json
experiments/reports/*.md
!experiments/reports/.gitkeep
