{
  "server": {
    "host": "127.0.0.1",
    "port": 8000
  },
  "database": {
    "local_db_path": "./local.db",
    "operations_db_path": "./operations.db"
  },
  "logging": {
    "log_level": "INFO",
    "max_bytes": 10485760,
    "backup_count": 5
  },
  "llm": {
    "openai_api_key": "",
    "anthropic_api_key": ""
  },
  "reference": {
    "cache_db_path": "./reference_api_cache.db",
    "reference_db_path": "./reference.db"
  },
  "recognition": {
    "individual_match_threshold": 0.90
  },
  "telemetry": {
    "enabled": true,
    "service_name": "context-studio-backend",
    "otlp_endpoint_grpc": "http://100.104.222.123:4317",
    "otlp_endpoint_http": "http://100.104.222.123:4318",
    "protocol": "grpc",
    "export_logs": true,
    "export_traces": true,
    "sample_rate": 1.0
  },
  "decision_models": {
    "default": "clef",
    "models": {
      "clef": {
        "adapter": "workers_ai",
        "model": "@cf/cloudflare/clef",
        "price_per_mtok_in": 0.24,
        "fallback": "llm-sonnet",
        "options": {
          "account_id": "",
          "api_token": ""
        }
      },
      "clef-flash": {
        "adapter": "workers_ai",
        "model": "@cf/cloudflare/clef-flash",
        "price_per_mtok_in": 0.09,
        "options": {
          "account_id": "",
          "api_token": ""
        }
      },
      "llm-sonnet": {
        "adapter": "llm",
        "model": "claude-sonnet-5-5"
      }
    }
  }
}
