{
  "name": "context-studio-ux",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port=3100",
    "build": "vite build",
    "serve": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run --no-coverage",
    "test:ci": "vitest run --reporter verbose --coverage",
    "test:coverage": "vitest run --coverage",
    "test:msw": "vitest run --config vitest.msw.config.ts",
    "test:e2e": "tsx scripts/check_test_contract.ts && playwright test",
    "test:e2e:ui": "tsx scripts/check_test_contract.ts && playwright test --ui",
    "test:e2e:debug": "tsx scripts/check_test_contract.ts && playwright test --debug",
    "test:e2e:headed": "tsx scripts/check_test_contract.ts && playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "validate-selectors": "tsx scripts/check_test_contract.ts",
    "generate-types": "openapi-typescript ../local-server/documentation/openapi.json -o src/api/types/index.ts && prettier --write src/api/types/index.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tanstack/react-form": "^1.14.2",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.116.0",
    "@tanstack/react-router-devtools": "^1.116.0",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.10.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reagraph": "^4.30.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/vite": "^4.1.4",
    "@tanstack/router-plugin": "^1.116.1",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-istanbul": "^1.6.1",
    "@vitest/coverage-v8": "^1.6.1",
    "c8": "^8.0.0",
    "eslint": "^10.0.2",
    "js-yaml": "^4.1.0",
    "jsdom": "^26.1.0",
    "msw": "^1.3.1",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.16.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.2.6",
    "vitest": "^1.6.1"
  },
  "vitest": {
    "environment": "jsdom",
    "setupFiles": "./vitest.setup.ts",
    "globals": true
  }
}
