{
  "name": "flowbite-react-template-tanstack-router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:run": "vitest run --no-coverage",
    "test:ci": "vitest run --reporter verbose --coverage",
    "test:coverage": "vitest run --coverage",
    "test:coverage:c8": "c8 --reporter=lcov --reporter=text npx vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "vite --port=3001",
    "build": "vite build",
    "serve": "vite preview",
    "start": "vite",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "postinstall": "flowbite-react patch",
    "generate-types": "openapi-typescript documentation/openapi.json -o src/api/client/types.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@tanstack/router-plugin": "^1.116.1",
    "@testing-library/dom": "^8.20.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/testing-library__react": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "jsdom": "^26.1.0",
    "msw": "^1.3.1",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.2.6",
    "vitest": "^1.6.1",
    "c8": "^8.0.0"
  },
  "vitest": {
    "environment": "jsdom",
    "setupFiles": "./vitest.setup.ts",
    "globals": true
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0",
    "@tanstack/react-form": "^1.14.2",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.116.0",
    "@tanstack/react-router-devtools": "^1.116.0",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.10.0",
    "flowbite-react": "^0.11.7",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-contenteditable": "^3.3.7",
    "react-dom": "^19.1.0"
  }
}
