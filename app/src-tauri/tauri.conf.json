{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Context Studio",
  "version": "0.1.0",
  "identifier": "com.tinkermonkey.contextstudio",
  "build": {
    "frontendDist": "../spike/splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Context Studio",
        "width": 1440,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": {
      "../spike/payload/": "payload/"
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
